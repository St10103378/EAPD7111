@model Logistics.Models.Contract

<h1>Create Contract</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="ClientId"></label>

        <select asp-for="ClientId"
                asp-items="ViewBag.ClientId"
                class="form-control">
        </select>

        <span asp-validation-for="ClientId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate"></label>

        <input asp-for="StartDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate"></label>

        <input asp-for="EndDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status"></label>

        <select asp-for="Status"
                class="form-control"
                asp-items="Html.GetEnumSelectList<Logistics.Enums.ContractStatus>()">
        </select>

        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Agreement PDF</label>

        <input asp-for="AgreementFile"
               type="file"
               class="form-control" />

        <span asp-validation-for="AgreementFile" class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-success">
        Save Contract
    </button>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}