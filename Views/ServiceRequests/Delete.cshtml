@model Logistics.Models.ServiceRequest

<h1>Delete Service Request</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this request?
</div>

<div class="card p-4">

    <p>
        <strong>Contract ID:</strong>
        @Model.ContractId
    </p>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Cost:</strong>
        @Model.Cost
    </p>

</div>

<br />

<form asp-action="Delete">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Cancel
    </a>

</form>